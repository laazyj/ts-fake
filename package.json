{
  "name": "ts-fake",
  "version": "1.1.0",
  "description": "Type-safe test utility for creating fakes of TypeScript interfaces and objects",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:examples": "tsc --project tsconfig.examples.json",
    "test:compat": "tsc --project tsconfig.compat.json",
    "test:types": "tsd",
    "check:exports": "attw --pack .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\" \"test-d/**/*.ts\" \"compat/**/*.{ts,mts,cts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"examples/**/*.ts\" \"test-d/**/*.ts\" \"compat/**/*.{ts,mts,cts}\"",
    "prerelease": "npm run lint && npm run format:check && npm run build && npm run check:exports && npm run test:coverage && npm run test:examples && npm run test:compat && npm run test:types && tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "typescript",
    "testing",
    "fake",
    "mock",
    "test-utility",
    "type-safe",
    "unit-testing"
  ],
  "author": "Jason Duffett (https://github.com/laazyj)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laazyj/ts-fake.git"
  },
  "bugs": {
    "url": "https://github.com/laazyj/ts-fake/issues"
  },
  "homepage": "https://github.com/laazyj/ts-fake#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.1",
    "tsd": "^0.33.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
